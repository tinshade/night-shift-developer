# ---------------------------------------------------------------------------
# dummy-api-server/.env  -  loaded into the fastapi and postgres containers.
# Copy to .env:   cp dummy-api-server/.env.example dummy-api-server/.env
#
# docker compose REFUSES TO START if this file is missing.
#
# POSTGRES_USER / PASSWORD / DB / HOST / PORT are set by docker-compose.yaml
# and override anything here - keep the database credentials in the ROOT .env.
# ---------------------------------------------------------------------------
ENV=development
