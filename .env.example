# ---------------------------------------------------------------------------
# Root .env  -  read by docker compose for ${VAR} substitution.
# Copy to .env and fill in your Groq key:   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Groq (required for repair attempts) -----------------------------------
GROQ_API_KEY=
GROQ_FREE_MODEL=openai/gpt-oss-120b
GROQ_CODE_MODEL=openai/gpt-oss-120b
GROQ_OPERATIONS_MODEL=openai/gpt-oss-20b

# --- Database (used by BOTH the postgres and fastapi services) -------------
POSTGRES_USER=dummy_db_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dummy_db

# --- Repair behaviour ------------------------------------------------------
MAX_REPAIR_ATTEMPTS=3
REPAIR_VALIDATION_COMMAND=python -m pytest -q --no-header -p no:cacheprovider tests/test_api_contract.py

# Which seeded defect the hourly cron run exercises: B1 | B2 | B3 | B4 | random
FORCE_ERROR_BUG=random

# --- Optional: GitHub pull requests ----------------------------------------
ENABLE_GITHUB_REPAIR=false
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=

# --- Optional: Gmail notifications -----------------------------------------
ENABLE_EMAIL_NOTIFICATIONS=false
GOOGLE_EMAIL_ID=
GOOGLE_APP_PASSWORD=
REPAIR_NOTIFICATION_EMAIL=
